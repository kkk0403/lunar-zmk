#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB       &kp Q  &kp W        &kp E      &kp R   &kp T        &kp Y   &kp U             &kp I            &kp O          &kp P         &kp TAB
&kp LEFT_ALT  &kp A  &kp S        &lt 4 D    &kp F   &lt 6 G      &kp H   &kp J             &lt 3 K          &kp L          &kp UP_ARROW  &kp RIGHT_ALT
&kp LSHIFT    &kp Z  &kp X        &kp C      &kp V   &lt 5 B      &kp N   &kp M             &kp SPACE        &kp LEFT       &kp DOWN      &kp RIGHT
                     &lt 1 ENTER  &kp LCTRL  &trans  &trans       &trans  &kp LEFT_CONTROL  &kp RIGHT_SHIFT  &kp BACKSPACE
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        right_layer {
            bindings = <
&kp ASTERISK   &kp PLUS   &kp NUMBER_9  &kp NUMBER_8   &kp NUMBER_7  &kp DOUBLE_QUOTES      &trans  &trans  &trans  &trans  &trans  &trans
&kp SLASH      &kp MINUS  &kp NUMBER_6  &kp NUMBER_5   &kp NUMBER_4  &kp PERIOD             &trans  &trans  &trans  &trans  &trans  &trans
&kp AMPERSAND  &kp EQUAL  &kp NUMBER_3  &kp NUMBER_2   &kp NUMBER_1  &kp NUMBER_0           &trans  &trans  &trans  &trans  &trans  &trans
                          &trans        &kp BACKSPACE  &trans        &trans                 &trans  &trans  &trans  &trans
            >;
        };

        left_layer {
            bindings = <
&trans  &kp PIPE     &kp DOUBLE_QUOTES  &kp SQT            &kp HASH               &kp GRAVE      &kp PLUS       &kp MINUS       &kp ASTERISK  &kp SLASH     &kp EQUAL        &trans
&trans  &kp AT_SIGN  &kp LEFT_BRACE     &kp LEFT_BRACKET   &kp LPAR               &trans         &kp AMPERSAND  &kp SEMI        &kp COLON     &kp PERCENT   &kp DELETE       &trans
&trans  &kp DOLLAR   &kp RIGHT_BRACE    &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp CARET      &bootloader    &kp UNDERSCORE  &kp TILDE     &kp QUESTION  &kp EXCLAMATION  &trans
                     &trans             &trans             &trans                 &trans         &trans         &trans          &trans        &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&trans  &kp F12  &kp F9  &kp F8  &kp F7  &trans      &bt BT_SEL 2  &bt BT_SEL 0  &trans  &trans  &trans  &trans
&trans  &kp F11  &kp F6  &kp F5  &kp F4  &trans      &bt BT_SEL 3  &bt BT_SEL 1  &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F3  &kp F2  &kp F1  &trans      &trans        &bt BT_CLR    &trans  &trans  &trans  &trans
                 &trans  &trans  &trans  &trans      &trans        &trans        &trans  &trans
            >;
        };

        move {
            bindings = <
&trans  &trans              &trans            &trans  &trans        &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans              &kp LS(TAB)       &trans  &kp TAB       &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp RS(LEFT_ARROW)  &kp RS(UP_ARROW)  &trans  &kp LS(DOWN)  &kp RS(RIGHT)      &trans  &trans  &trans  &trans  &trans  &trans
                            &trans            &trans  &trans        &trans             &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &bootloader  &trans      &trans         &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans       &kp DELETE  &kp BACKSPACE  &kp SPACE  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT     &kp RIGHT   &mkp MB2       &mkp MB3   &trans      &trans  &trans  &trans  &trans  &trans  &trans
                     &trans      &mkp MB1       &trans     &trans      &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans         &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans         &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans         &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &kp PAGE_DOWN  &kp PAGE_UP  &trans  &trans      &trans  &trans  &trans  &trans
            >;
        };
    };
};
