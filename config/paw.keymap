#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "hold_tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&trans        &kp Q  &kp W             &kp E      &kp R           &kp T        &kp Y   &kp U                       &kp I        &kp O                     &kp P         &trans
&kp LEFT_ALT  &kp A  &kp S             &lt 4 D    &ht LEFT_ALT F  &kp G        &kp H   &kp J                       &kp K        &kp L                     &kp UP_ARROW  &trans
&kp TAB       &kp Z  &kp X             &lt 3 C    &lt 6 V         &lt 5 B      &kp N   &kp M                       &kp SPACE    &kp LEFT                  &kp DOWN      &kp RIGHT
                     &lt 1 LEFT_SHIFT  &kp LCTRL  &trans          &trans       &trans  &ht LEFT_CONTROL BACKSPACE  &lt 2 ENTER  &ht LC(LEFT_SHIFT) COMMA
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp PAGE_UP PG_DN>;
        };

        right_layer {
            bindings = <
&kp PLUS      &kp MINUS      &kp NUMBER_9  &kp NUMBER_8   &kp NUMBER_7  &kp DOUBLE_QUOTES      &trans  &trans  &trans  &trans  &trans  &trans
&kp ASTERISK  &kp SLASH      &kp NUMBER_6  &kp NUMBER_5   &kp NUMBER_4  &kp PERIOD             &trans  &trans  &trans  &trans  &trans  &trans
&kp EQUAL     &kp AMPERSAND  &kp NUMBER_3  &kp NUMBER_2   &kp NUMBER_1  &kp NUMBER_0           &trans  &trans  &trans  &trans  &trans  &trans
                             &trans        &kp BACKSPACE  &trans        &trans                 &trans  &trans  &trans  &trans
            >;
        };

        left_layer {
            bindings = <
&trans  &kp PIPE  &kp DOUBLE_QUOTES  &kp SQT  &trans  &kp GRAVE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE
&trans  &trans    &trans             &trans   &trans  &trans         &kp EQUAL             &kp AMPERSAND          &kp COLON         &kp SEMICOLON      &kp PERCENT     &kp DOLLAR
&trans  &trans    &trans             &trans   &trans  &trans         &kp COMMA             &kp QUESTION           &kp EXCLAMATION   &kp TILDE          &kp AT_SIGN     &kp HASH
                  &trans             &trans   &trans  &trans         &trans                &trans                 &trans            &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&bt BT_CLR    &kp F12  &kp F9     &kp F8  &kp F7  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &kp F11  &kp F6     &kp F5  &kp F4  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 1  &kp F10  &kp F3     &trans  &kp F1  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                       &kp LG(D)  &kp F2  &trans  &trans      &trans  &trans  &trans  &trans
            >;
        };

        move {
            bindings = <
&trans  &trans              &trans            &trans  &trans        &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans              &kp LEFT_SHIFT    &trans  &kp LEFT_ALT  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp RS(LEFT_ARROW)  &kp RS(UP_ARROW)  &trans  &kp LS(DOWN)  &kp RS(RIGHT)      &trans  &trans  &trans  &trans  &trans  &trans
                            &trans            &trans  &trans        &trans             &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &bootloader  &trans      &trans     &trans         &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans       &kp DELETE  &kp SPACE  &kp BACKSPACE  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT     &kp RIGHT   &mkp MB2   &mkp MB3       &trans      &trans  &trans  &trans  &trans  &trans  &trans
                     &kp ENTER   &mkp MB1   &trans         &trans      &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans         &trans        &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans         &trans        &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans         &kp LEFT_ALT  &trans  &kp TAB      &trans  &trans  &trans  &trans  &trans  &trans
                &kp PAGE_DOWN  &kp PAGE_UP   &trans  &trans       &trans  &trans  &trans  &trans
            >;
        };
    };
};
